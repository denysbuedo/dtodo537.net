{
  "name": "@dtodo/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "corepack pnpm --filter @dtodo/config build && corepack pnpm --filter @dtodo/types build && corepack pnpm --filter @dtodo/validation build && tsx watch --exclude \"../../packages/**/dist/**\" src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dtodo/config": "workspace:*",
    "@dtodo/types": "workspace:*",
    "@dtodo/validation": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.1",
    "@prisma/client": "6.2.1",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie": "1.0.2",
    "ioredis": "5.4.2",
    "pino": "9.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@dtodo/eslint-config": "workspace:*",
    "@nestjs/testing": "10.4.15",
    "@types/cookie": "0.6.0",
    "@types/express": "5.0.0",
    "@types/supertest": "6.0.2",
    "eslint": "9.18.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
