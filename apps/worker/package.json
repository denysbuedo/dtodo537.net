{
  "name": "@dtodo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "corepack pnpm --filter @dtodo/config build && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.726.1",
    "@dtodo/config": "workspace:*",
    "@prisma/client": "6.2.1",
    "bullmq": "5.34.2",
    "ioredis": "5.4.2",
    "pino": "9.6.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@dtodo/eslint-config": "workspace:*",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
