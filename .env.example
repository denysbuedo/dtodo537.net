# Environment
NODE_ENV=development

# Public platform URLs
APP_BASE_DOMAIN=dtodo537.net
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

# PostgreSQL
# Replace user, password, host, port and database with local credentials.
DATABASE_URL=postgresql://dtodo_user:dtodo_password@localhost:5432/dtodo537_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Sessions
# Use a long random value in real environments. Never commit real secrets.
SESSION_SECRET=change-me-use-a-long-random-secret-at-least-32-chars

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dtodo537-dev
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key

# OpenAPI
ENABLE_OPENAPI=true
