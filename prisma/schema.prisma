generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FoundationProbe {
  id        String   @id @default(uuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@map("foundation_probes")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  memberships             Membership[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
}

enum MembershipRole {
  BUSINESS_OWNER
  BUSINESS_MANAGER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  DRAFT
  PENDING
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum ShowroomStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum ThemeStatus {
  ACTIVE
  DISABLED
}

enum ContactChannelType {
  PHONE
  EMAIL
}

enum SocialProfileType {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  X
  LINKEDIN
  WEBSITE
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductPriceMode {
  FIXED
  FROM
  CONTACT
  FREE
}

enum ProductAvailabilityStatus {
  AVAILABLE
  OUT_OF_STOCK
  ON_REQUEST
  COMING_SOON
  UNAVAILABLE
}

enum ProductPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum MediaAssetType {
  IMAGE
  DOCUMENT
}

enum StorageProvider {
  S3
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum MediaVariantKind {
  ORIGINAL
  THUMBNAIL
  CARD
  LARGE
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  memberships            Membership[]
  businesses             Business[]
  showrooms              Showroom[]
  subscriptions          Subscription[]
  contactChannels        ContactChannel[]
  socialProfiles         SocialProfile[]
  whatsappConfigurations WhatsAppConfiguration[]
  themeConfigurations    ThemeConfiguration[]
  categories             Category[]
  products               Product[]
  mediaAssets            MediaAsset[]
  mediaVariants          MediaVariant[]
  productImages          ProductImage[]
  productAttributes      ProductAttribute[]

  @@map("tenants")
}

model Membership {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model BusinessType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]

  @@map("business_types")
}

model Business {
  id               String         @id @default(uuid())
  tenantId         String
  businessTypeId   String?
  name             String
  slug             String
  legalName        String?
  description      String?
  shortDescription String?
  address          String?
  phone            String?
  email            String?
  timezone         String?
  logoUrl          String?
  coverImageUrl    String?
  logoMediaId      String?
  coverMediaId     String?
  status           BusinessStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  businessType          BusinessType?          @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
  showroom              Showroom?
  contactChannels       ContactChannel[]
  socialProfiles        SocialProfile[]
  whatsappConfiguration WhatsAppConfiguration?
  categories            Category[]
  products              Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([businessTypeId])
  @@map("businesses")
}

model Showroom {
  id             String         @id @default(uuid())
  tenantId       String
  businessId     String         @unique
  subdomain      String         @unique
  customDomain   String?
  status         ShowroomStatus @default(DRAFT)
  themeId        String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  theme              Theme?              @relation(fields: [themeId], references: [id], onDelete: SetNull)
  themeConfiguration ThemeConfiguration?

  @@index([tenantId])
  @@index([themeId])
  @@map("showrooms")
}

model Theme {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  description    String?
  previewMediaId String?
  version        String
  status         ThemeStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  showrooms           Showroom[]
  themeConfigurations ThemeConfiguration[]

  @@map("themes")
}

model ThemeConfiguration {
  id               String   @id @default(uuid())
  tenantId         String
  showroomId       String   @unique
  themeId          String
  primaryColor     String
  secondaryColor   String
  accentColor      String
  fontFamily       String
  coverStyle       String
  productCardStyle String
  configuration    Json?
  updatedAt        DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  showroom Showroom @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  theme    Theme    @relation(fields: [themeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([themeId])
  @@map("theme_configurations")
}

model ContactChannel {
  id         String             @id @default(uuid())
  tenantId   String
  businessId String
  type       ContactChannelType
  value      String
  label      String?
  isPrimary  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([businessId])
  @@map("contact_channels")
}

model SocialProfile {
  id         String            @id @default(uuid())
  tenantId   String
  businessId String
  type       SocialProfileType
  url        String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([businessId])
  @@map("social_profiles")
}

model WhatsAppConfiguration {
  id             String   @id @default(uuid())
  tenantId       String
  businessId     String   @unique
  phoneNumber    String
  defaultMessage String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("whatsapp_configurations")
}

model Category {
  id           String         @id @default(uuid())
  tenantId     String
  businessId   String
  parentId     String?
  name         String
  slug         String
  description  String?
  imageMediaId String?
  position     Int            @default(0)
  status       CategoryStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parent     Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]  @relation("CategoryHierarchy")
  imageMedia MediaAsset? @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  products   Product[]

  @@unique([businessId, slug])
  @@index([tenantId])
  @@index([businessId])
  @@index([parentId])
  @@index([imageMediaId])
  @@map("categories")
}

model Product {
  id                 String                    @id @default(uuid())
  tenantId           String
  businessId         String
  categoryId         String?
  name               String
  slug               String
  shortDescription   String?
  description        String?
  price              Decimal?                  @db.Decimal(12, 2)
  previousPrice      Decimal?                  @db.Decimal(12, 2)
  currency           String                    @default("CUP") @db.Char(3)
  priceMode          ProductPriceMode          @default(CONTACT)
  availabilityStatus ProductAvailabilityStatus @default(AVAILABLE)
  publicationStatus  ProductPublicationStatus  @default(DRAFT)
  featured           Boolean                   @default(false)
  position           Int                       @default(0)
  publishedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  attributes ProductAttribute[]

  @@unique([businessId, slug])
  @@index([tenantId])
  @@index([businessId])
  @@index([categoryId])
  @@index([publicationStatus])
  @@map("products")
}

model ProductAttribute {
  id        String @id @default(uuid())
  tenantId  String
  productId String
  name      String
  value     String
  position  Int    @default(0)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_attributes")
}

model MediaAsset {
  id              String           @id @default(uuid())
  tenantId        String
  type            MediaAssetType   @default(IMAGE)
  storageProvider StorageProvider  @default(S3)
  bucket          String
  objectKey       String
  originalName    String?
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  status          MediaAssetStatus @default(PENDING_UPLOAD)
  errorMessage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  variants       MediaVariant[]
  productImages  ProductImage[]
  categoryImages Category[]     @relation("CategoryImage")

  @@index([tenantId])
  @@index([status])
  @@map("media_assets")
}

model MediaVariant {
  id              String           @id @default(uuid())
  tenantId        String
  mediaAssetId    String
  kind            MediaVariantKind
  storageProvider StorageProvider  @default(S3)
  bucket          String
  objectKey       String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  createdAt       DateTime         @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, kind])
  @@index([tenantId])
  @@index([mediaAssetId])
  @@map("media_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  mediaId   String
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  altText   String?
  createdAt DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([tenantId])
  @@index([productId])
  @@index([mediaId])
  @@map("product_images")
}

model SubscriptionPlan {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String
  planId    String
  status    SubscriptionStatus @default(TRIALING)
  startedAt DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([planId])
  @@map("subscriptions")
}
